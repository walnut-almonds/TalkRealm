{
    "servers": {
        // "github/github-mcp-server": {
        //     "type": "http",
        //     "url": "https://api.githubcopilot.com/mcp/"
        // },
        // "context7": {
        //     "type": "http",
        //     "url": "https://mcp.context7.com/mcp/oauth"
        // },
        "gopls": {
            "command": "gopls",
            "args": [
                "mcp"
            ]
        },
        "stitch": {
            "url": "https://stitch.googleapis.com/mcp",
            "type": "http",
            "headers": {
                "Accept": "application/json",
                "X-Goog-Api-Key": "${input:stitch_api_key}"
            }
        }
    },
    "inputs": [
        {
            "id": "stitch_api_key",
            "type": "promptString",
            "description": "Enter your Stitch API Key",
            "password": true
        }
    ]
}