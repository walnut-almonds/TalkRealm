# TalkRealm API - REST Client
# 推薦擴充套件：VS Code REST Client (humao.rest-client)
#
# 快速開始：
# 1) 啟動伺服器：make dev 或 go run ./cmd/server
# 2) 依序執行請求（建議先執行 register → login 取得 token）
#
# 說明：
# - 帶有 # @name xxx 的請求結果可在後續請求用 {{xxx.response.body.$.field}} 引用
# - Authorization 需要先執行 login，再將 access_token 填入 @token

@baseUrl = http://localhost:8080
@token = <在此貼上 login 回傳的 access_token>

# =============================================================================
# 健康檢查
# =============================================================================

### Health Check
GET {{baseUrl}}/health HTTP/1.1

### Ping
GET {{baseUrl}}/ping HTTP/1.1


# =============================================================================
# 認證 Auth
# =============================================================================

### 註冊使用者
# @name register
POST {{baseUrl}}/api/v1/auth/register HTTP/1.1
Content-Type: application/json

{
  "username": "testuser",
  "email": "testuser@example.com",
  "password": "password123",
  "nickname": "Test User"
}

### 登入
# @name login
POST {{baseUrl}}/api/v1/auth/login HTTP/1.1
Content-Type: application/json

{
  "email": "testuser@example.com",
  "password": "password123"
}

### 換發 Access Token (Refresh)
POST {{baseUrl}}/api/v1/auth/refresh HTTP/1.1
Content-Type: application/json

{
  "refresh_token": "{{login.response.body.$.refresh_token}}"
}

### 登出 (撤銷 Refresh Token)
POST {{baseUrl}}/api/v1/auth/logout HTTP/1.1
Content-Type: application/json

{
  "refresh_token": "{{login.response.body.$.refresh_token}}"
}


# =============================================================================
# 使用者 Users
# =============================================================================

### 取得公開使用者資料（不需登入）
GET {{baseUrl}}/api/v1/users/1 HTTP/1.1

### 取得當前登入使用者資訊
GET {{baseUrl}}/api/v1/users/me HTTP/1.1
Authorization: Bearer {{token}}

### 更新當前登入使用者資訊
PATCH {{baseUrl}}/api/v1/users/me HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nickname": "New Nickname",
  "avatar": "https://example.com/avatar.png",
  "status": "online"
}


# =============================================================================
# 社群 Guilds
# =============================================================================

### 建立社群
# @name createGuild
POST {{baseUrl}}/api/v1/guilds HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "My Guild",
  "description": "A test guild",
  "icon": ""
}

### 列出我加入的社群
GET {{baseUrl}}/api/v1/guilds/me HTTP/1.1
Authorization: Bearer {{token}}

### 取得社群詳情
GET {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 更新社群
PATCH {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Updated Guild Name",
  "description": "Updated description"
}

### 刪除社群
DELETE {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 加入社群（直接加入）
POST {{baseUrl}}/api/v1/guilds/1/join HTTP/1.1
Authorization: Bearer {{token}}

### 離開社群
POST {{baseUrl}}/api/v1/guilds/1/leave HTTP/1.1
Authorization: Bearer {{token}}

### 列出社群成員
GET {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}}/members HTTP/1.1
Authorization: Bearer {{token}}

### 踢出成員（需要 admin 角色）
DELETE {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}}/members/2 HTTP/1.1
Authorization: Bearer {{token}}

### 更新成員角色（需要 admin 角色）
PUT {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}}/members/2/role HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "role": "admin"
}


# =============================================================================
# 社群邀請碼 Guild Invites
# =============================================================================

### 建立邀請碼
# @name createInvite
POST {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}}/invites HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "max_uses": 10,
  "expires_in": 86400
}

### 查詢邀請碼資訊（不需登入）
GET {{baseUrl}}/api/v1/invites/{{createInvite.response.body.$.code}} HTTP/1.1

### 透過邀請碼加入社群
POST {{baseUrl}}/api/v1/guilds/join-by-invite HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "{{createInvite.response.body.$.code}}"
}


# =============================================================================
# 頻道 Channels
# =============================================================================

### 列出社群的所有頻道
GET {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}}/channels HTTP/1.1
Authorization: Bearer {{token}}

### 建立文字頻道（需要 admin 角色）
# @name createChannel
POST {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}}/channels HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "general",
  "type": "text",
  "topic": "General discussion",
  "position": 0
}

### 建立語音頻道（需要 admin 角色）
POST {{baseUrl}}/api/v1/guilds/{{createGuild.response.body.$.id}}/channels HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "Voice Chat",
  "type": "voice",
  "position": 1
}

### 取得頻道詳情
GET {{baseUrl}}/api/v1/channels/{{createChannel.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 更新頻道
PATCH {{baseUrl}}/api/v1/channels/{{createChannel.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "general-updated",
  "topic": "Updated topic"
}

### 更新頻道排序
PUT {{baseUrl}}/api/v1/channels/{{createChannel.response.body.$.id}}/position HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "position": 2
}

### 刪除頻道
DELETE {{baseUrl}}/api/v1/channels/{{createChannel.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}


# =============================================================================
# 訊息 Messages
# =============================================================================

### 在頻道中發送訊息
# @name sendMessage
POST {{baseUrl}}/api/v1/channels/{{createChannel.response.body.$.id}}/messages HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Hello, TalkRealm!",
  "type": "text",
  "nonce": "unique-nonce-uuid-v4"
}

### 列出頻道訊息（最新 50 則）
GET {{baseUrl}}/api/v1/channels/{{createChannel.response.body.$.id}}/messages HTTP/1.1
Authorization: Bearer {{token}}

### 列出頻道訊息（cursor 分頁，取指定 ID 之前的訊息）
GET {{baseUrl}}/api/v1/channels/{{createChannel.response.body.$.id}}/messages?before={{sendMessage.response.body.$.id}}&limit=20 HTTP/1.1
Authorization: Bearer {{token}}

### 取得單則訊息
GET {{baseUrl}}/api/v1/messages/{{sendMessage.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}

### 更新訊息
PATCH {{baseUrl}}/api/v1/messages/{{sendMessage.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "content": "Edited message content"
}

### 刪除訊息
DELETE {{baseUrl}}/api/v1/messages/{{sendMessage.response.body.$.id}} HTTP/1.1
Authorization: Bearer {{token}}


# =============================================================================
# WebSocket 連線
# =============================================================================
# WebSocket 端點：ws://localhost:8080/api/v1/ws
#
# REST Client 不支援 WebSocket，請使用瀏覽器或 wscat 測試：
#   wscat -c ws://localhost:8080/api/v1/ws
#
# 連線後需發送 identify op 完成認證：
# {
#   "op": "identify",
#   "data": { "token": "<access_token>" }
# }
#
# 認證成功後可發送訊息：
# {
#   "op": "send_message",
#   "data": {
#     "channel_id": 1,
#     "content": "Hello via WebSocket!"
#   }
# }
