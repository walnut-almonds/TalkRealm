# 對應 configs/config.prod.yaml 內 ${VAR} 佔位符；envsubst 用這份渲染出 config.yaml
# 非機敏值（local cluster 用），可直接進 git
DB_USER=talk-realm
DB_NAME=talk-realm
DB_PASSWORD=local_talk-realm_password
REDIS_PASSWORD=local_talk-realm_redis_password
JWT_SECRET=local-only-jwt-secret-not-for-production-use
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=talkrealm
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_PUBLIC_URL=ws://localhost:7880
DEEPL_API_KEY=
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
